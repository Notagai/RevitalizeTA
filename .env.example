# Public HTTPS origin of YOUR exported/deployed Expo app server (no path).
# Native production builds require this value. Never point it at the unofficial TA API.
EXPO_PUBLIC_APP_ORIGIN=https://your-app.example

# Server-only production rate limiter. Do not prefix any of these with EXPO_PUBLIC_.
# Provision a Redis REST endpoint supporting EVAL; no grades/passwords are stored in it.
AUTH_REDIS_REST_URL=https://your-database.upstash.io
AUTH_REDIS_REST_TOKEN=replace-with-server-only-token
AUTH_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
